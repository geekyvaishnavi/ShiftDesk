# Copy to .env for a local run without Docker. `docker compose up` sets both
# of these itself and does not read this file.

# Any PostgreSQL instance. This is the one compose.yaml exposes on 5433.
DATABASE_URL="postgresql://shiftdesk:shiftdesk@localhost:5433/shiftdesk"

# Signs the session cookie. Any non-empty string; a tampered cookie fails
# verification and reads as signed out.
AUTH_SECRET="local-development-secret-not-for-production"
